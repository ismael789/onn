{
  "expo": {
    "name": "onn Remote",
    "slug": "onn-remote",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.onnremote.app",
      "permissions": [
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#8b5cf6",
          "defaultChannel": "tv-status"
        }
      ],
      "./app.plugin.js",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0f0f14"
        }
      ]
    ]
  }
}
